<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ejercicio1punto5.PrimaryController">
   <children>
      <HBox spacing="20"  >
            <Label text="Alimentación" />
            <TextField fx:id="txtAlimentacion"/>
            <Label text="Estadisticas" />
      </HBox>
      <HBox spacing="20" >
            <Label text="Refrigerios" />
            <TextField fx:id="txtRefrigerios"/>
            <Label text="Total semanal"/>
      </HBox>
      <HBox spacing="20" >
            <Label text="Transporte" />
            <TextField fx:id="txtTransporte"/>
            <TextField fx:id="txtTotal" />
      </HBox>
      <HBox spacing="20"  >
            <Label text="Telofonía" />
            <TextField fx:id="txtTelefonia"/>
            <Label text="Gasto más alto"/>
      </HBox>
      <HBox spacing="20" >
            <Label text="Otros" />
            <TextField fx:id="txtOtros"/>
            <TextField  fx:id="txtMasAlto"/>
      </HBox>
      <HBox spacing="10" >
      <Button fx:id="btnCalcular" text="Calcular Estadisticas" onAction="#btnCalcular_Click" />
      <Button fx:id="btnLimpiar" text="Limpiar" onAction="#btnLimpiar_Click"/>
      </HBox>
   </children>
   

   
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
