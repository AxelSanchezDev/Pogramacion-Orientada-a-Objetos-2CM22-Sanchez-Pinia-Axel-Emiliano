<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ejercicio1punto3.PrimaryController">
    
    <HBox spacing="15.0" alignment="CENTER_LEFT">
        <Label text="Ingrese un número" prefWidth="120.0" />
        <TextField fx:id="txtNumero" prefWidth="120.0" />
        <Button fx:id="btnAnalizar" text="Analizar" onAction="#btnAnalizar_Click" />
        <Button fx:id="btnLimpiar" text="Limpiar" onAction="#btnLimpiar_Click" />
    </HBox>

    <HBox spacing="30.0">
        

        <VBox spacing="10.0">
            <HBox spacing="15.0" alignment="CENTER_LEFT">
                <Label text="Cantidad de cifras" prefWidth="140.0" />
                <TextField fx:id="txtCantCif" prefWidth="90.0" />
            </HBox>
            
            <HBox spacing="15.0" alignment="CENTER_LEFT">
                <Label text="Suma de cifras impares" prefWidth="140.0" />
                <TextField fx:id="txtSumCifImp" prefWidth="90.0" />
            </HBox>
            
            <HBox spacing="15.0" alignment="CENTER_LEFT">
                <Label text="Suma de cifras pares" prefWidth="140.0" />
                <TextField fx:id="txtSumCifPar" prefWidth="90.0" />
            </HBox>
            
            <HBox spacing="15.0" alignment="CENTER_LEFT">
                <Label text="Suma total de cifras" prefWidth="140.0" />
                <TextField fx:id="txtSumTot" prefWidth="90.0" />
            </HBox>
            
            <HBox spacing="15.0" alignment="CENTER_LEFT">
                <Label text="Cifra mayor" prefWidth="140.0" />
                <TextField fx:id="txtCM" prefWidth="90.0" />
            </HBox>
            
            <HBox spacing="15.0" alignment="CENTER_LEFT">
                <Label text="Cifra menor" prefWidth="140.0" />
                <TextField fx:id="txtCm" prefWidth="90.0" />
            </HBox>
        </VBox>
        <VBox spacing="5.0">
            <Label text="Divisores" />
            <TextArea fx:id="txtDivisores" prefWidth="160.0" prefHeight="200.0" />
        </VBox>

    </HBox>
      
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>