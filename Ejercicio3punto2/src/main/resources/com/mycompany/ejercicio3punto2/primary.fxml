<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ejercicio3punto2.PrimaryController">
    
    <Label text="La Liebre y la Tortuga" />
    
    <Button fx:id="btnIniciar" text="¡Iniciar Carrera!" onAction="#btnIniciar_Click" />
    
    <VBox spacing="5.0">
        <HBox spacing="10.0" alignment="CENTER" >
            <Label text="La Liebre:" />
            <Label fx:id="lblEstadoLiebre" text="Esperando" />
        </HBox>
        <HBox spacing="10.0" alignment="CENTER" >
        <ProgressBar fx:id="progressLiebre" progress="0.0" prefWidth="400.0" />
        </HBox>
    </VBox>

    <VBox spacing="5.0">
        <HBox spacing="10.0" alignment="CENTER">
            <Label text="La Tortuga:" />
            <Label fx:id="lblEstadoTortuga" text="Esperando" />
        </HBox>
        <HBox spacing="10.0" alignment="CENTER" >
        <ProgressBar fx:id="progressTortuga" progress="0.0" prefWidth="400.0" />
        </HBox>
    </VBox>

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>